  "landing": {
    "hero": {
      "title": "One digital campus for every school",
      "subtitle": "UniHub helps universities, colleges, and high schools run student portals, online learning, payments, schedules, announcements, and communication from one branded workspace.",
      "cta": "Request a school workspace",
      "demo": "Explore the demo"
    },
    "features": {
      "title": "What each school gets",
      "feature1": "Student Portal",
      "feature1Desc": "Students can see courses, assignments, results, fees, schedules, announcements, and profile details in one place.",
      "feature2": "Learning Management",
      "feature2Desc": "Teachers can organize course materials, assignments, submissions, class updates, and learning activity.",
      "feature3": "Academic Operations",
      "feature3Desc": "Administrators can manage courses, students, teachers, timetables, results, and institution records.",
      "feature4": "Campus Communication",
      "feature4Desc": "Students, teachers, and administrators can exchange messages and share official notices quickly.",
      "feature5": "Fees and Payments",
      "feature5Desc": "Schools can track tuition balances, payment history, pending fees, receipts, and finance reports.",
      "feature6": "Branded School Spaces",
      "feature6Desc": "Every institution gets its own portal, e-learning space, user roles, branding, and subscription plan."
    },
    "about": {
      "title": "Built as a platform, not a single-school website",
      "description": "UniHub is designed for many institutions to use the same core system while keeping their own identity. A university, college, or high school can create a workspace, customize its portal, manage its learners and teachers, and pay monthly or annually based on the plan it needs."
    },
    "pricing": {
      "title": "Plans for different institution sizes",
      "basic": "Starter",
      "standard": "Growth",
      "premium": "Enterprise",
      "monthly": "per month, billed monthly or annually",
      "students": "students",
      "features": "Included features"
    },
    "testimonials": {
      "title": "Who UniHub is for",
      "testimonial1": "A university can bring student records, course activity, finance, and communication into one reliable portal.",
      "testimonial2": "A college can launch a branded LMS without building separate systems for classes, fees, and announcements.",
      "testimonial3": "A high school can give parents, learners, teachers, and administrators clearer access to daily academic information."
    },
    "faq": {
      "title": "Frequently Asked Questions",
      "q1": "Is UniHub only for universities?",
      "a1": "No. The platform is built for universities, colleges, high schools, training centers, and other learning institutions.",
      "q2": "Can each school customize its portal?",
      "a2": "Yes. Each institution can use its own name, users, academic structure, portal content, and subscription plan.",
      "q3": "Can a school pay monthly or annually?",
      "a3": "Yes. UniHub is designed as a subscription service with monthly and annual billing options."
    },
